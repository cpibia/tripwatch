[Unit]
Description=tripwatch sensor
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/tripwatch-sensor -bundle /etc/tripwatch/bundle.json
Restart=always
RestartSec=5

# Runs as root to read every file, but with only the capabilities needed to observe; it reads
# input planted by attackers, so the rest of the surface is closed.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_AUDIT_READ
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tripwatch
StateDirectory=tripwatch
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Not set on purpose: ProtectKernelModules hides /usr/lib/modules, whose files the package
# verification must read (module loading is impossible anyway without CAP_SYS_MODULE);
# PrivateTmp, PrivateDevices and ProtectProc would hide the real /tmp, /dev/shm and other
# processes from the sensor, which is precisely where it has to look.
# The collectors bound their own memory well below this limit.
MemoryMax=512M
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
