# Names the sensors use to reach this machine: they go into the server certificate.
TRIPWATCH_HOSTNAMES=verifier.example.net
# Address written into each host's bundle.
TRIPWATCH_PUBLIC_INGEST_URL=https://verifier.example.net:8443/v1/envelopes
# Address of the web interface behind the proxy, for the links in the emails. With https the
# session cookies are marked Secure.
TRIPWATCH_PUBLIC_UI_URL=https://tripwatch.example.net

# First user, created only while there is none. Remove the password once signed in.
TRIPWATCH_ADMIN_EMAIL=ops@example.net
TRIPWATCH_ADMIN_PASSWORD=

# Email notifications for critical and high alerts (leave TRIPWATCH_SMTP_HOST empty to disable).
TRIPWATCH_SMTP_HOST=
TRIPWATCH_SMTP_PORT=587
TRIPWATCH_SMTP_USER=
TRIPWATCH_SMTP_PASSWORD=
TRIPWATCH_SMTP_FROM=tripwatch@example.net
TRIPWATCH_NOTIFY_TO=ops@example.net

# A host is silent after this long without heartbeats; snapshots are overdue after the second.
TRIPWATCH_SILENCE_AFTER=3m
TRIPWATCH_SNAPSHOTS_AFTER=3h

# Time zone of the times shown in the interface and in the emails.
TZ=Europe/Rome
